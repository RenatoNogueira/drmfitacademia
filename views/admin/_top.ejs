<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %></title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/css/admin-messages.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/css/admin-testimonials.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/css/admin-content.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/css/admin-bookings.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/css/admin-schedule.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/css/admin-payments.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/css/admin-media.css?v=<%= assetVersion %>">
</head>
<body class="admin">
<% const icons = {"conteudo": "<path d=\"M4 20h4L19 9l-4-4L4 16v4z\"/><path d=\"M13.5 6.5l4 4\"/>", "pagamentos": "<rect x=\"3\" y=\"6\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M3 10h18M7 15h3\"/>", "agendamentos": "<rect x=\"4\" y=\"5\" width=\"16\" height=\"15\" rx=\"2\"/><path d=\"M8 3v4M16 3v4M4 10h16\"/>", "mensagens": "<path d=\"M4 6h16v10H9l-5 4V6z\"/>", "depoimentos": "<path d=\"M12 4l2.4 5 5.6.7-4 3.9 1 5.5-5-2.7-5 2.7 1-5.5-4-3.9 5.6-.7L12 4z\"/>", "horarios": "<circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"M12 7.5V12l3 2\"/>", "imagens": "<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><circle cx=\"9\" cy=\"10\" r=\"1.5\"/><path d=\"M4 18l5-4 4 3 3-2 4 3\"/>", "galeria": "<rect x=\"3\" y=\"3\" width=\"8\" height=\"8\" rx=\"1.5\"/><rect x=\"13\" y=\"3\" width=\"8\" height=\"8\" rx=\"1.5\"/><rect x=\"3\" y=\"13\" width=\"8\" height=\"8\" rx=\"1.5\"/><rect x=\"13\" y=\"13\" width=\"8\" height=\"8\" rx=\"1.5\"/>"};
const tabs = [
  { href: '/admin/conteudo', label: 'Conteúdo', match: '/conteudo' },
  { href: '/admin/pagamentos', label: 'Pagamentos', match: '/pagamentos', badge: typeof pendingPayments !== 'undefined' ? pendingPayments : 0 },
  { href: '/admin/agendamentos', label: 'Agendamentos', match: '/agendamentos', badge: typeof pendingBookings !== 'undefined' ? pendingBookings : 0, title: 'agendamentos aguardando confirmação' },
  { href: '/admin/mensagens', label: 'Mensagens', match: '/mensagens', badge: typeof unreadMessages !== 'undefined' ? unreadMessages : 0 },
  { href: '/admin/depoimentos', label: 'Depoimentos', match: '/depoimentos' },
  { href: '/admin/horarios', label: 'Horários', match: '/horarios' },
  { href: '/admin/imagens', label: 'Imagens', match: '/imagens' },
  { href: '/admin/galeria', label: 'Galeria', match: '/galeria' }
]; %>
<header class="a-header">
  <div class="a-wrap a-header-in">
    <a class="a-logo" href="/admin"><img src="/img/logo-transparent.png" alt="DRMFIT" height="40"><span>Painel</span></a>
    <nav class="a-nav" aria-label="Admin">
      <% tabs.forEach(t => { %><a href="<%= t.href %>" class="<%= adminPath.startsWith(t.match) ? 'on' : '' %>"<%- adminPath.startsWith(t.match) ? ' aria-current="page"' : '' %>><svg class="a-ico" viewBox="0 0 24 24" aria-hidden="true"><%- icons[t.match.slice(1)] %></svg><span><%= t.label %></span><% if (t.badge) { %> <span class="a-dot" data-dot="<%= t.match.slice(1) %>"<% if (t.title) { %> title="<%= t.badge %> <%= t.title %>"<% } %>><%= t.badge %></span><% } %></a><% }) %>
    </nav>
    <div class="a-actions">
      <a href="/" target="_blank" rel="noopener" class="a-link">Ver site ↗</a>
      <form method="post" action="/admin/logout"><button class="a-btn a-btn-ghost" type="submit">Sair</button></form>
    </div>
  </div>
</header>
<main class="a-wrap a-main">
<% if (storeName === 'local') { %>
  <div class="a-note">Modo local: os dados ficam em arquivos deste computador. Para publicar na Vercel, configure o Supabase (veja o README).</div>
<% } %>

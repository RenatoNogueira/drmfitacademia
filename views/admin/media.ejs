<%- include('_top') %>
<%
const all = groups.flatMap((g) => g.items);
const state = (s) => (s.removed ? 'removed' : s.custom ? 'custom' : s.current ? 'default' : 'empty');
const count = (st) => all.filter((s) => state(s) === st).length;
const slug = (n) => 'g-' + n.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-');
%>
<div class="a-title"><h1>Imagens do site</h1></div>
<p class="a-muted">Clique na foto ou arraste uma imagem sobre ela para trocar. Imagens grandes são reduzidas automaticamente antes do envio.</p>

<div class="m-bar">
  <div class="m-filters" role="group" aria-label="Filtrar por situação" data-m-filters>
    <button type="button" class="on" data-filter="all">Todas <b><%= all.length %></b></button>
    <button type="button" data-filter="custom">Personalizadas <b><%= count('custom') %></b></button>
    <button type="button" data-filter="default">Padrão do site <b><%= count('default') %></b></button>
    <% if (count('removed') + count('empty')) { %><button type="button" data-filter="off">Sem foto <b><%= count('removed') + count('empty') %></b></button><% } %>
  </div>
  <input class="m-search" type="search" placeholder="Buscar espaço…" aria-label="Buscar espaço de imagem" data-m-search autocomplete="off">
</div>

<nav class="m-groups" aria-label="Ir para o grupo">
  <% groups.forEach((g) => { %><a href="#<%= slug(g.name) %>"><%= g.name %> <span><%= g.items.length %></span></a><% }) %>
</nav>

<% groups.forEach((g) => { %>
  <section class="m-section" id="<%= slug(g.name) %>" data-m-section>
    <h2 class="a-h2"><%= g.name %></h2>
    <div class="a-cards m-cards">
      <% g.items.forEach((s) => { const st = state(s); %>
        <article class="a-card a-media m-card" data-key="<%= s.key %>" data-state="<%= st %>" data-text="<%= (s.label + ' ' + s.group + ' ' + s.hint).toLowerCase() %>">
          <div class="a-thumb m-thumb" data-drop>
            <% if (s.current) { %><img src="<%= s.current %>" alt="<%= s.label %>" loading="lazy"><% } else { %><span class="m-empty"><%= s.removed ? 'Foto removida' : 'Sem foto' %></span><% } %>
            <em class="m-chip m-chip-<%= st %>"><%= { custom: 'Personalizada', default: 'Padrão do site', removed: 'Removida', empty: 'Sem foto' }[st] %></em>
            <label class="m-drop" aria-label="Trocar foto: <%= s.label %>">
              <span>⬆ Clique ou solte a imagem aqui</span>
              <input type="file" accept="image/jpeg,image/png,image/webp" data-upload hidden>
            </label>
            <span class="m-busy" hidden><i></i><b>Enviando…</b></span>
          </div>
          <h3><%= s.label %></h3>
          <p class="a-muted a-small"><%= s.hint %></p>
          <p class="m-dim a-small" data-dim hidden></p>
          <div class="m-actions">
            <label class="a-btn a-btn-sm"><%= s.current ? 'Trocar foto' : 'Enviar foto' %>
              <input type="file" accept="image/jpeg,image/png,image/webp" data-upload hidden>
            </label>
            <% if (s.removed) { %><button class="a-btn a-btn-sm a-btn-ghost" type="button" data-restore-media>Restaurar padrão</button><% } %>
            <% if (s.custom && !s.removed) { %><button class="a-btn a-btn-sm a-btn-ghost" type="button" data-reset>Voltar ao padrão</button><% } %>
            <% if (s.current) { %><button class="a-btn a-btn-sm a-btn-danger" type="button" data-remove-media>Remover</button><% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
<% }) %>
<p class="a-empty" data-m-empty hidden>Nenhum espaço encontrado com esse filtro.</p>
<%- include('_bottom') %>

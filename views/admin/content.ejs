<%- include('_top') %>
<div class="a-title"><h1>Conteúdo do site</h1></div>
<p class="a-muted">Edite textos, contato, preços, cores e mais. Fotos ficam em <a class="a-inline" href="/admin/imagens">Imagens</a>, depoimentos em <a class="a-inline" href="/admin/depoimentos">Depoimentos</a>. Campos que você não mexer continuam com o texto padrão.</p>

<div class="a-content">
  <nav class="a-groups" aria-label="Seções do site">
    <% groups.forEach(g => { %>
      <a href="/admin/conteudo?g=<%= g.id %>" class="<%= g.id === group.id ? 'on' : '' %>"><%= g.title %><% if (edited.has(g.id)) { %><i class="a-edited" title="Editado"></i><% } %></a>
    <% }) %>
  </nav>

  <form class="a-card a-content-form" data-content-form data-group="<%= group.id %>" autocomplete="off">
    <div class="a-content-head">
      <div>
        <h2><%= group.title %></h2>
        <p class="a-muted"><%= group.hint %></p>
      </div>
    </div>

    <% group.fields.forEach(f => { %>
      <%- include('_field', { f, current, S }) %>
    <% }) %>

    <% if (typeof pixPreview !== 'undefined' && pixPreview) { %>
      <section class="a-pix-preview" aria-label="Prévia do QR Code">
        <% if (pixPreview.error) { %>
          <div><h3>Prévia do QR Code</h3><p class="a-pix-error"><%= pixPreview.error %></p><p class="a-muted a-small">Preencha os campos acima e salve para ver o QR Code aqui.</p></div>
        <% } else { %>
          <div class="a-pix-qr"><% if (pixPreview.mode === 'image') { %><img src="<%= pixPreview.imageUrl %>" alt="QR Code PIX enviado por você"><% } else { %><%- pixPreview.svg %><% } %></div>
          <div>
            <h3>Prévia do QR Code <%= pixPreview.enabled ? '' : '(pagamento desativado)' %></h3>
            <% if (pixPreview.mode === 'generated') { %><p class="a-muted a-small">Exemplo com o valor do plano <strong><%= pixPreview.plan %></strong>: <strong><%= pixPreview.amountLabel %></strong> para <strong><%= pixPreview.receiver %></strong> (<%= pixPreview.city %>). Mostra as configurações já salvas.</p><% } else { %><p class="a-muted a-small">Esta é a imagem que o aluno vai ver.</p><% } %>
            <% if (pixPreview.copyPaste) { %><div class="a-pix-code"><%= pixPreview.copyPaste %></div><% } %>
          </div>
        <% } %>
      </section>
    <% } %>

    <div class="a-row a-row-center a-sticky-actions">
      <button class="a-btn" type="submit">Salvar alterações</button>
      <a class="a-btn a-btn-ghost" href="/" target="_blank" rel="noopener">Ver site ↗</a>
      <span class="a-spacer"></span>
      <% if (edited.has(group.id)) { %><button class="a-btn a-btn-ghost a-btn-danger" type="button" data-reset-group>Restaurar textos padrão desta seção</button><% } %>
    </div>
  </form>
</div>
<%- include('_bottom') %>

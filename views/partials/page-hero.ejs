<section class="page-hero">
  <% const bg = img('topo-paginas'); %>
  <% if (bg) { %><div class="page-hero-bg" style="background-image:url('<%= bg %>')"></div><% } %>
  <div class="container">
    <span class="eyebrow"><%= h.eyebrow %></span>
    <h1><%= h.before %> <span class="outline"><%= h.highlight %></span><% if (h.after) { %> <%= h.after %><% } %></h1>
    <p><%= h.text %></p>
  </div>
</section>

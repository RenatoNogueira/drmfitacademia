</main>

<% if (typeof hideCta === 'undefined') { %>
<section class="cta-band">
  <div class="container cta-inner">
    <div>
      <h2><%= site.copy.cta.before %> <span class="outline"><%= site.copy.cta.highlight %></span></h2>
      <p><%= site.copy.cta.text %></p>
    </div>
    <a class="btn btn-whatsapp" target="_blank" rel="noopener" href="<%= site.whatsappLink('Olá! Quero agendar uma aula experimental na DRMFIT.') %>">
      <%- include('icon', { name: 'whatsapp' }) %> <%= site.copy.cta.button %>
    </a>
  </div>
</section>
<% } %>

<%
const ft = site.copy.footer;
const socials = [['instagram', 'Instagram'], ['facebook', 'Facebook'], ['youtube', 'YouTube']].filter(([k]) => site.brand[k]);
// Links que apontam para seções ocultas (ou sem itens) não aparecem
const sectionOf = { '#sobre': () => site.sections.about, '#servicos': () => site.sections.services && site.modalities.length, '#planos': () => site.sections.plans && site.plans.length, '#aulas': () => site.sections.classes && site.classes.length, '#equipe': () => site.sections.trainers && site.trainers.length, '#contato': () => site.sections.contact };
const footLinks = (site.footerLinks || []).filter((l) => { const m = String(l.href).match(/#[a-z]+$/); return !(m && sectionOf[m[0]]) || sectionOf[m[0]](); });
const extLink = (h) => /^https?:/i.test(h);
%>
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a href="/" class="logo"><% if (mediaHidden('logo')) { %><span class="logo-text"><span class="lime"><%= site.brand.name.slice(0, 3) %></span><%= site.brand.name.slice(3) %></span><% } else { %><img src="<%= img('logo') || '/img/logo-transparent.png' %>" alt="<%= site.brand.name %> Academia" width="133" height="52"><% } %></a>
      <p class="muted"><%= site.brand.tagline %> <%= ft.about %></p>
      <% if (ft.showSocial && socials.length) { %>
      <div class="social">
        <% socials.forEach(([k, label]) => { %><a href="<%= site.brand[k] %>" target="_blank" rel="noopener" aria-label="<%= label %>"><%- include('icon', { name: k }) %></a><% }) %>
      </div>
      <% } %>
    </div>
    <% if (ft.showLinks && footLinks.length) { %>
    <div>
      <h4><%= ft.linksTitle %></h4>
      <ul>
        <% footLinks.forEach((l) => { %><li><a href="<%= l.href %>"<%- extLink(l.href) ? ' target="_blank" rel="noopener"' : '' %>><%= l.label %></a></li><% }) %>
      </ul>
    </div>
    <% } %>
    <% if (ft.showHours && site.schedule.hours.length) { %>
    <div>
      <h4><%= ft.hoursTitle %></h4>
      <ul class="muted">
        <% site.schedule.hours.forEach(h => { %>
          <li><%= h.label %>: <strong><%= h.value %></strong></li>
        <% }) %>
      </ul>
    </div>
    <% } %>
    <% if (ft.showContact) { %>
    <div>
      <h4><%= ft.contactTitle %></h4>
      <ul class="muted">
        <li><%= site.brand.address %></li>
        <li><a href="tel:+<%= site.brand.whatsappNumber %>"><%= site.brand.phone %></a></li>
        <li><a href="mailto:<%= site.brand.email %>"><%= site.brand.email %></a></li>
      </ul>
    </div>
    <% } %>
  </div>
  <div class="container footer-bottom">
    <span>&copy; <%= year %> <%= site.brand.name %> Academia. <%= ft.copyright %></span>
    <% if (ft.extra) { %><span class="footer-extra"><%= ft.extra %></span><% } %>
  </div>
</footer>

<a class="wa-float" target="_blank" rel="noopener" aria-label="Fale conosco no WhatsApp" href="<%= site.whatsappLink('Olá! Gostaria de saber mais sobre a DRMFIT.') %>">
  <%- include('icon', { name: 'whatsapp' }) %>
</a>

<button class="to-top" id="to-top" aria-label="Voltar ao topo"><%- include('icon', { name: 'up' }) %></button>

<div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Visualizador de mídia">
  <button class="lightbox-close" id="lightbox-close" aria-label="Fechar"><%- include('icon', { name: 'x' }) %></button>
  <div class="lightbox-body" id="lightbox-body"></div>
</div>

<%- include('sections/booking') %>
<% if (typeof payEnabled !== 'undefined' && payEnabled) { %><%- include('sections/payment') %><% } %>

<script src="/js/main.js?v=<%= assetVersion %>" defer></script>
<script src="/js/booking.js?v=<%= assetVersion %>" defer></script>
<% if (typeof payEnabled !== 'undefined' && payEnabled) { %><script src="/js/payment.js?v=<%= assetVersion %>" defer></script><% } %>
</body>
</html>

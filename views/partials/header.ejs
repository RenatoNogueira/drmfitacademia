<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="DRMFIT - academia completa com musculação, aulas coletivas, personal trainers e planos a partir de R$ 99. Agende sua aula experimental grátis.">
  <meta name="theme-color" content="#0b0b0d">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%
const nav = [
  { href: '/#inicio', label: 'Início' },
  { href: '/#sobre', label: 'Sobre' },
  { href: '/#servicos', label: 'Serviços' },
  { href: '/#aulas', label: 'Aulas' },
  { href: '/#planos', label: 'Planos' },
  { href: '/#equipe', label: 'Equipe' },
  { href: '/#contato', label: 'Contato' }
];
%>
<header class="site-header" id="top">
  <div class="scroll-progress" id="scroll-progress"></div>
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="DRMFIT - página inicial"><img src="/img/logo-transparent.png" alt="DRMFIT Academia" width="133" height="52"></a>
    <nav class="main-nav" id="main-nav" aria-label="Principal">
      <% nav.forEach(item => { %>
        <a href="<%= item.href %>" data-spy="<%= item.href.split('#')[1] %>"><%= item.label %></a>
      <% }) %>
      <a href="/#contato" class="btn btn-sm nav-cta">Agendar treino</a>

      <div class="nav-extra">
        <a class="btn btn-whatsapp btn-block" target="_blank" rel="noopener" href="<%= site.whatsappLink('Olá! Gostaria de agendar uma aula experimental na DRMFIT.') %>">
          <%- include('icon', { name: 'whatsapp' }) %> Chamar no WhatsApp
        </a>
        <p class="nav-address"><%- include('icon', { name: 'pin' }) %> <%= site.brand.address %></p>
        <div class="nav-social">
          <a href="<%= site.brand.instagram %>" target="_blank" rel="noopener" aria-label="Instagram"><%- include('icon', { name: 'instagram' }) %></a>
          <a href="<%= site.brand.facebook %>" target="_blank" rel="noopener" aria-label="Facebook"><%- include('icon', { name: 'facebook' }) %></a>
          <a href="<%= site.brand.youtube %>" target="_blank" rel="noopener" aria-label="YouTube"><%- include('icon', { name: 'youtube' }) %></a>
        </div>
      </div>
    </nav>
    <button class="nav-toggle" id="nav-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="main-nav">
      <span class="ico-open"><%- include('icon', { name: 'menu' }) %></span>
      <span class="ico-close"><%- include('icon', { name: 'x' }) %></span>
    </button>
  </div>
</header>
<main>

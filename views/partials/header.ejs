<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="<%= site.copy.seo.description %>">
  <meta name="theme-color" content="#0b0b0d">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
  <style>:root { --accent: <%= site.theme.accent %>; --accent-dark: <%= site.theme.accentDark %>; }</style>
</head>
<body>
<%
const sec = site.sections;
const nav = [
  { href: '/#inicio', label: site.copy.nav.home, show: true },
  { href: '/#sobre', label: site.copy.nav.about, show: sec.about },
  { href: '/#servicos', label: site.copy.nav.services, show: sec.services && site.modalities.length },
  { href: '/#aulas', label: site.copy.nav.classes, show: sec.classes && site.classes.length },
  { href: '/#planos', label: site.copy.nav.plans, show: sec.plans && site.plans.length },
  { href: '/#equipe', label: site.copy.nav.team, show: sec.trainers && site.trainers.length },
  { href: '/#contato', label: site.copy.nav.contact, show: sec.contact }
].filter((n) => n.show);
%>
<header class="site-header" id="top">
  <div class="scroll-progress" id="scroll-progress"></div>
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="DRMFIT - página inicial"><img src="<%= img('logo') || '/img/logo-transparent.png' %>" alt="<%= site.brand.name %> Academia" width="133" height="52"></a>
    <nav class="main-nav" id="main-nav" aria-label="Principal">
      <% nav.forEach((item) => { %>
        <a href="<%= item.href %>" data-spy="<%= item.href.split('#')[1] %>"><%= item.label %></a>
      <% }) %>
      <a href="/#avaliacao" data-spy="avaliacao" class="btn btn-sm nav-cta"><%= site.copy.nav.cta %></a>

      <div class="nav-extra">
        <a class="btn btn-whatsapp btn-block" target="_blank" rel="noopener" href="<%= site.whatsappLink('Olá! Gostaria de agendar uma aula experimental na DRMFIT.') %>">
          <%- include('icon', { name: 'whatsapp' }) %> Chamar no WhatsApp
        </a>
        <p class="nav-address"><%- include('icon', { name: 'pin' }) %> <%= site.brand.address %></p>
        <div class="nav-social">
          <% [['instagram', 'Instagram'], ['facebook', 'Facebook'], ['youtube', 'YouTube']].filter(([k]) => site.brand[k]).forEach(([k, label]) => { %>
          <a href="<%= site.brand[k] %>" target="_blank" rel="noopener" aria-label="<%= label %>"><%- include('icon', { name: k }) %></a>
          <% }) %>
        </div>
      </div>
    </nav>
    <button class="nav-toggle" id="nav-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="main-nav">
      <span class="ico-open"><%- include('icon', { name: 'menu' }) %></span>
      <span class="ico-close"><%- include('icon', { name: 'x' }) %></span>
    </button>
  </div>
</header>
<main>

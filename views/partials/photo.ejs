<% const src = img(name); %>
<% if (src) { %>
  <img src="<%= src %>" alt="<%= alt %>" loading="lazy">
<% } else { %>
  <div class="ph" role="img" aria-label="<%= alt %>">
    <%- include('icon', { name: 'camera' }) %>
    <% if (typeof devHints !== 'undefined' && devHints) { %><small>Adicione <code>public/media/<%= name %>.jpg</code></small><% } %>
  </div>
<% } %>

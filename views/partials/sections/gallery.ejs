<% const pics = galleryImages(); %>
<% if (site.sections.gallery && (pics.length || devHints)) { %><%# SECTION-FLAG %>
<section class="section gallery-sec">
  <div class="container">
    <div class="section-head split-head">
      <div>
        <%- include('../head', { h: site.copy.gallery }) %>
      </div>
      <div class="carousel-nav">
        <button type="button" data-carousel-prev aria-label="Fotos anteriores"><%- include('../icon', { name: 'back' }) %></button>
        <button type="button" data-carousel-next aria-label="Próximas fotos"><%- include('../icon', { name: 'arrow' }) %></button>
      </div>
    </div>
  </div>
  <div class="gallery" data-carousel>
    <% if (pics.length) { %>
      <% pics.forEach(src => { %>
        <button type="button" class="g-item" data-image="<%= src %>" aria-label="Ampliar foto"><img src="<%= src %>" alt="Foto da academia DRMFIT" loading="lazy"></button>
      <% }) %>
    <% } else { %>
      <% for (let i = 1; i <= 5; i++) { %>
        <div class="g-item"><div class="ph"><%- include('../icon', { name: 'camera' }) %><% if (devHints) { %><small>Adicione fotos em <code>public/media/galeria/</code></small><% } %></div></div>
      <% } %>
    <% } %>
  </div>
</section>
<% } %>

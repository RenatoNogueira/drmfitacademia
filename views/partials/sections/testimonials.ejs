<% if (site.sections.testimonials && testimonials && testimonials.length) { %>
<section class="section alt">
  <div class="container">
    <div class="section-head center">
      <%- include('../head', { h: site.copy.testimonials }) %>
    </div>
    <div class="grid grid-3">
      <% testimonials.forEach(t => { %>
        <figure class="card testimonial reveal">
          <% if (t.result) { %><span class="result"><%= t.result %></span><% } %>
          <blockquote>“<%= t.quote %>”</blockquote>
          <figcaption>
            <% if (t.photo_url) { %><img class="t-avatar" src="<%= t.photo_url %>" alt="" loading="lazy" width="44" height="44"><% } %>
            <span><%= t.name %></span>
          </figcaption>
        </figure>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

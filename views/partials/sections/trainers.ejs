<% if (site.sections.trainers && site.trainers.length) { %><%# SECTION-FLAG %>
<section class="section" id="equipe">
  <div class="container">
    <div class="section-head center">
      <%- include('../head', { h: site.copy.trainers }) %>
    </div>
    <div class="grid grid-4">
      <% site.trainers.forEach((t, i) => { %>
        <article class="trainer reveal">
          <div class="photo">
            <% const src = img(t.key || 'equipe-' + (i + 1)); %>
            <% if (src) { %><img src="<%= src %>" alt="<%= t.name %>" loading="lazy">
            <% } else { %><div class="ph"><span class="initials"><%= t.initials %></span><small><code><%= t.key || 'equipe-' + (i + 1) %>.jpg</code></small></div><% } %>
          </div>
          <h3><%= t.name %></h3>
          <p><%= t.role %></p>
        </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

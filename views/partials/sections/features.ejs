<section class="section alt">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">Por que a DRMFIT</span>
      <h2>Tudo para o seu <span class="outline">resultado</span></h2>
    </div>
    <div class="grid grid-3">
      <% site.features.forEach((f, i) => { %>
        <article class="card feature reveal">
          <span class="num"><%= String(i + 1).padStart(2, '0') %></span>
          <div>
            <h3><%= f.title %></h3>
            <p><%= f.text %></p>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

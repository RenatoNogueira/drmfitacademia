<section class="section" id="planos">
  <div class="container">
    <div class="section-head center">
      <%- include('../head', { h: site.copy.plans }) %>
      <% if (site.copy.plans.text) { %><p><%= site.copy.plans.text %></p><% } %>
    </div>
    <div class="grid grid-3 plans">
      <% site.plans.forEach(p => { %>
        <article class="card plan reveal <%= p.highlight ? 'featured' : '' %>">
          <% if (p.highlight) { %><span class="badge"><%= site.copy.plans.badge %></span><% } %>
          <h3><%= p.name %></h3>
          <div class="price"><small>R$</small><strong><%= p.price %></strong><span><%= p.period %></span></div>
          <ul class="checklist">
            <% p.items.forEach(i => { %>
              <li><%- include('../icon', { name: 'check' }) %> <%= i %></li>
            <% }) %>
          </ul>
          <a class="btn <%= p.highlight ? '' : 'btn-outline' %>" href="/contato?plano=<%= encodeURIComponent(p.name) %>"><%= site.copy.plans.button %> <%= p.name %></a>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<% if (site.sections.plans && site.plans.length) { %><%# SECTION-FLAG %>
<section class="section" id="planos">
  <div class="container">
    <div class="section-head center">
      <%- include('../head', { h: site.copy.plans }) %>
      <% if (site.copy.plans.text) { %><p><%= site.copy.plans.text %></p><% } %>
    </div>
    <% const n = site.plans.length; const cols = n <= 4 ? n : 3; %>
    <div class="plans" data-n="<%= n %>" style="--cols: <%= cols %>">
      <% site.plans.forEach(p => { %>
        <article class="card plan reveal <%= p.highlight ? 'featured' : '' %>">
          <% if (p.highlight) { %><span class="badge"><%= site.copy.plans.badge %></span><% } %>
          <h3><%= p.name %></h3>
          <div class="price"><small>R$</small><strong><%= p.price %></strong><span><%= p.period %></span></div>
          <ul class="checklist">
            <% p.items.forEach(i => { %>
              <li><%- include('../icon', { name: 'check' }) %> <%= i %></li>
            <% }) %>
          </ul>
          <a class="btn <%= p.highlight ? '' : 'btn-outline' %>" href="/contato?plano=<%= encodeURIComponent(p.name) %>"<% if (typeof payEnabled !== 'undefined' && payEnabled) { %> data-subscribe="<%= p.name %>" data-price="<%= p.price %><%= p.period %>"<% } %>><%= site.copy.plans.button %> <%= p.name %></a>
        </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

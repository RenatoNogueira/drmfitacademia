<% if (site.sections.faq && site.faqs.length) { %><%# SECTION-FLAG %>
<section class="section">
  <div class="container narrow">
    <div class="section-head center">
      <%- include('../head', { h: site.copy.faq }) %>
    </div>
    <% site.faqs.forEach(f => { %>
      <details class="faq reveal">
        <summary><%= f.q %></summary>
        <p><%= f.a %></p>
      </details>
    <% }) %>
  </div>
</section>
<% } %>

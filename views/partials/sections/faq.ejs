<section class="section">
  <div class="container narrow">
    <div class="section-head center">
      <span class="eyebrow">Dúvidas</span>
      <h2>Perguntas <span class="outline">frequentes</span></h2>
    </div>
    <% site.faqs.forEach(f => { %>
      <details class="faq reveal">
        <summary><%= f.q %></summary>
        <p><%= f.a %></p>
      </details>
    <% }) %>
  </div>
</section>

# Copie para .env (local) ou cadastre em Vercel → Settings → Environment Variables.

# Senha do painel /admin (obrigatória; sem ela o painel fica desativado)
ADMIN_PASSWORD=

# Texto longo e aleatório para assinar o login (opcional, recomendado em produção)
SESSION_SECRET=

# Supabase (obrigatório na Vercel; localmente, sem isto, os dados ficam em arquivos)
SUPABASE_URL=
# Chave SECRETA (sb_secret_...). Não use a publishable.
SUPABASE_SECRET_KEY=
# Nome do bucket de imagens (padrão: media)
SUPABASE_BUCKET=media
